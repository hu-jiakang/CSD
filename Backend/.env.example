# Customer & Store Dashboard - Backend
# Copy to .env on the deployment host and fill in approved values.
PORT=3002
NODE_ENV=production

# Kingdee K3Cloud third-party integration. Keep disabled until configured and verified.
KINGDEE_ENABLED=false
KINGDEE_BASE_URL=
KINGDEE_ERP_ACCOUNT=
KINGDEE_INTEGRATION_USERNAME=
KINGDEE_APP_ID=
KINGDEE_APP_SECRET=
KINGDEE_LANGUAGE_ID=2052

# K3 data scope
KINGDEE_ORGANIZATION=100
KINGDEE_ORGANIZATION_FIELD=FUseOrgId.FNumber

# Local SQLite databases (paths are relative to the Backend working directory by default)
DATABASE_PATH=./data/kingdee.db
AUTH_DATABASE_PATH=./data/customer-store-dashboard.db

# Automatic synchronization: preserve the existing 30-minute interval
KINGDEE_SYNC_ON_STARTUP=true
KINGDEE_SYNC_INTERVAL_MINUTES=30

# DingTalk SSO credentials; fill only if DingTalk SSO is enabled for this deployment
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=

# Administrator login settings
CSD_ADMIN_PASSWORD=
CSD_INITIAL_PASSWORD=
