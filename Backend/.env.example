# Customer & Store Dashboard - Backend

PORT=3002
NODE_ENV=development

# Set a unique administrator password before production deployment.
# Empty disables the dedicated administrator login.
CSD_ADMIN_PASSWORD=
CSD_INITIAL_PASSWORD=

# Kingdee K3Cloud Third-Party Integration
# Set true only after the dedicated K3Cloud third-party application is configured.
KINGDEE_ENABLED=false
KINGDEE_BASE_URL=placeholder
KINGDEE_ERP_ACCOUNT=placeholder
KINGDEE_INTEGRATION_USERNAME=placeholder
KINGDEE_APP_ID=placeholder
KINGDEE_APP_SECRET=placeholder
KINGDEE_LANGUAGE_ID=2052

# K3 Data Scope
KINGDEE_ORGANIZATION=100
KINGDEE_ORGANIZATION_FIELD=FUseOrgId.FNumber

# Dashboard local databases
DATABASE_PATH=./data/kingdee.db
AUTH_DATABASE_PATH=./data/customer-store-dashboard.db

# Automatic synchronization
KINGDEE_SYNC_ON_STARTUP=true
KINGDEE_SYNC_INTERVAL_MINUTES=30

# DingTalk Internal Application / Micro App SSO
# DingTalk is SSO only and is NOT used as the Kingdee K3 authorization.
DINGTALK_CLIENT_ID=placeholder
DINGTALK_CLIENT_SECRET=placeholder
DINGTALK_CORP_ID=placeholder
DINGTALK_AGENT_ID=placeholder
